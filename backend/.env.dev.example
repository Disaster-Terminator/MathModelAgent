ENV=dev
# support all model, check out https://docs.litellm.ai/docs/providers
# e.g. gpt-4.1,deepseek/deepseek-chat
# docs/md/tutorial
# 为每个 agent 配置合适的模型
COORDINATOR_API_KEY=
COORDINATOR_MODEL=
# COORDINATOR_BASE_URL= 如果需要中转自定义等 地址后面添加 /v1
# COORDINATOR_MAX_TOKENS=

# 推荐 thinking model
MODELER_API_KEY=
MODELER_MODEL=
# MODELER_BASE_URL=
# MODELER_MAX_TOKENS=

CODER_API_KEY=
CODER_MODEL=
# CODER_BASE_URL=
# CODER_MAX_TOKENS=

WRITER_API_KEY=
WRITER_MODEL=
# WRITER_BASE_URL=
# WRITER_MAX_TOKENS=

# 全局 LiteLLM 兜底配置（当各 agent 未单独配置时使用）
# 自定义模型请通过 OpenAI 兼容格式填写，例如 openai/kimi-k2.6
LITELLM_API_URL=
LITELLM_API_KEY=
MODEL=

# 模型最大问答次数
MAX_CHAT_TURNS=100000
# 思考反思次数
MAX_RETRIES=1000
# 协调/建模 JSON 解析重试次数
PARSE_RETRIES=1000
# 单个建模任务总超时秒数
TASK_TIMEOUT_SECONDS=604800
# 远程代码解释器初始化超时秒数
CODE_INTERPRETER_TIMEOUT=100000
# 单次 LLM 请求超时秒数，避免供应商连接挂住后任务静默等待
LLM_REQUEST_TIMEOUT=300

# 不需要填，默认调用本地 Python
# E2B_API_KEY=
SERVER_HOST=http://localhost:8000
# 使用 email 注册账号从 https://openalex.org/ 文献
OPENALEX_EMAIL=

LOG_LEVEL=DEBUG
DEBUG=true
# 确保安装 Redis
# 如果是docker: REDIS_URL=redis://redis:6379/0
# 本地部署 : redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
